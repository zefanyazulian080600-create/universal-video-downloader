# ==============================================================================
# UNIVERSAL TELEGRAM VIDEO DOWNLOADER (LinkGrabber Bot) - ENVIRONMENT CONFIG
# ==============================================================================
# Salin file ini menjadi .env dan isi dengan konfigurasi riil Anda.
# JANGAN PERNAH menyertakan file .env asli Anda ke dalam git repository!

# Telegram Bot Token dari @BotFather (Wajib)
# Contoh: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID Pemilik Bot / Administrator (Opsional untuk akses /admin)
# Dapatkan user ID Anda melalui bot @userinfobot di Telegram
BOT_OWNER_ID=0

# URL Database (SQLAlchemy 2.x Async)
# Default menggunakan SQLite async via aiosqlite
# Untuk PostgreSQL gunakan: postgresql+asyncpg://user:password@localhost:5432/linkgrabber
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Level Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Direktori Penyimpanan Sementara untuk proses download
TEMP_DIR=./downloads

# Batas Maksimum Ukuran Pengiriman Telegram dalam MB (Default 50 MB untuk Bot API standar)
# Jika menggunakan Telegram Bot API Server lokal pribadi, ini dapat ditingkatkan hingga 2000 MB (2 GB)
MAX_UPLOAD_MB=50

# Batas Maksimum Ukuran Unduhan dari Platform sebelum dibatalkan dalam MB
MAX_DOWNLOAD_MB=200

# Durasi Maksimum Video yang diizinkan dalam detik (Contoh: 1800 detik = 30 menit)
MAX_VIDEO_DURATION_SECONDS=1800

# Batas Maksimum Pekerjaan Unduhan Berjalan Bersamaan secara Global
MAX_CONCURRENT_DOWNLOADS=3

# Batas Maksimum Pekerjaan Unduhan Berjalan Bersamaan per Pengguna
MAX_JOBS_PER_USER=2

# Batas Waktu Ekstraksi Metadata dalam detik
METADATA_TIMEOUT_SECONDS=30

# Batas Waktu Pengunduhan Video dalam detik
DOWNLOAD_TIMEOUT_SECONDS=600

# Aktifkan integrasi FFmpeg untuk penggabungan stream dan ekstraksi metadata ffprobe
ENABLE_FFMPEG=true

# Aktifkan fitur kompresi video menggunakan FFmpeg jika file melebihi batas upload
ENABLE_COMPRESSION=false

# Retensi riwayat pekerjaan dalam hari sebelum dibersihkan otomatis
JOB_RETENTION_DAYS=7

# Batas permintaan pesan per pengguna per menit (Anti-spam / Rate limiting)
USER_RATE_LIMIT=10
